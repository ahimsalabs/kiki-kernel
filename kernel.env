# kiki's guest kernel: Kata Containers' pinned kernel and config, plus the
# patches in patches/ and the fragments in fragments/. build.sh and
# source.sh read this file, and the build workflow publishes ghcr.io/ahimsalabs/kiki-kernel:${RELEASE} with
# RELEASE=${KERNEL_VERSION}-${KATA_CONFIG_VERSION}-kiki.${KIKI_REVISION}.
#
# kiki follows Kata (README.md has the procedure): when a Kata release moves
# assets.kernel.version in versions.yaml or
# tools/packaging/kernel/kata_config_version, move the Kata and Linux
# values together and reset KIKI_REVISION to 1. When anything else that
# changes the kernel's bytes changes (a patch, a fragment, the builder), bump
# KIKI_REVISION alone. A release is published once: installed kikis pin
# its blobs by digest.
KATA_VERSION=4.3.1
KATA_COMMIT=03cf2ec06a5d302f23af811744f6bcea49988bfb
KERNEL_VERSION=6.18.56
KATA_CONFIG_VERSION=208
KIKI_REVISION=1
# linux-${KERNEL_VERSION}.tar.xz from kernel.org, as its sha256sums.asc
# lists it.
LINUX_SHA256=4633bbda2ab95eaf2a7af4041236451d6759c72e6946265531af4b3aacefbf89
# The build's timestamp (KBUILD_BUILD_TIMESTAMP, the tars' mtimes): the
# Kata commit's committer time, so a rebuild of the same inputs gives the
# same bytes.
SOURCE_DATE_EPOCH=1792614631
